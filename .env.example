# ==== Общие настройки сайта ====
NEXT_PUBLIC_SITE_URL=https://preobrazhenie-festival.ru
NEXT_PUBLIC_CONTACT_PHONE=+7 900 000-00-00
NEXT_PUBLIC_CONTACT_EMAIL=info@preobrazhenie-festival.ru
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/preobrazhenie_festival
NEXT_PUBLIC_VK_URL=https://vk.com/preobrazhenie_festival

# ==== Административная панель ====
# Пароль для входа в /admin (временный механизм, см. README "Как заменить вход в админку").
ADMIN_PASSWORD=change-me-before-launch
# Секрет для подписи сессионной cooky администратора. Сгенерируйте случайную строку 32+ символов.
ADMIN_SESSION_SECRET=change-me-32-characters-minimum

# ==== База данных / Supabase (опционально, см. README "Подключение Supabase") ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ==== Платёжный провайдер ====
# demo | yookassa | cloudpayments
PAYMENT_PROVIDER=demo
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=

# ==== Уведомления по email (опционально) ====
EMAIL_API_KEY=
ADMIN_EMAIL=admin@preobrazhenie-festival.ru

# ==== Аналитика (опционально) ====
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
